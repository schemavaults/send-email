{
  "name": "@schemavaults/send-email",
  "description": "Schema defining the shape of the request body to send an email via @schemavaults/mail-server",
  "version": "0.3.1",
  "license": "UNLICENSED",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schemavaults/send-email.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "schemavaults-send-email": "dist/cli.js"
  },
  "dependencies": {
    "zod": "4.4.3",
    "commander": "14.0.1"
  },
  "scripts": {
    "build:lib": "tsc --project tsconfig.json && tsc-alias --project tsconfig.json",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --banner:js=\"import{createRequire as __createRequire}from'module';const require=__createRequire(import.meta.url);\"",
    "build": "bun run build:lib && bun run build:cli",
    "test": "NODE_ENV=test bun test",
    "cleanup:compiled-tests-output": "find ./dist -type f \\( -name \"*.test.js\" -o -name \"*.test.js.map\" -o -name \"*.test.d.ts\" \\) -delete",
    "cleanup": "bun run cleanup:compiled-tests-output",
    "chmod:cli": "chmod +x dist/cli.js",
    "postbuild": "bun run cleanup && bun run chmod:cli",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsc-alias": "1.8.16",
    "bun-types": "1.3.11",
    "esbuild": "^0.25.0",
    "eslint": "9.39.1",
    "@eslint/js": "9.39.1",
    "globals": "16.5.0",
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*",
      "import": "./dist/*",
      "require": "./dist/*"
    },
    "./dist/*": {
      "types": "./dist/*",
      "import": "./dist/*",
      "require": "./dist/*"
    }
  },
  "packageManager": "bun@1.3.11"
}
